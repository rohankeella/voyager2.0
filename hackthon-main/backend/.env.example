# Copy to .env and fill in real values.
DATABASE_URL=sqlite:///./voyager.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS: comma-separated origins for the Next.js frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Google Maps Distance Matrix API key. If unset, backend falls back
# to Haversine distance + a fixed speed heuristic per travel mode.
GOOGLE_MAPS_API_KEY=

# Amadeus Self-Service — powers /api/travel/hotels, /flights, /locations.
# If both values are blank the backend serves deterministic MOCK offers so
# the frontend still works — no signup required for demos.
#
# To use real live data (free tier, no card required):
#   1. Sign up at https://developers.amadeus.com/register
#   2. Verify your email, then create a Self-Service app in "My apps"
#   3. Copy the API Key + API Secret into the two lines below
#   4. Restart uvicorn
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (sandbox — matches signup) or "production" (after Amadeus approves).
AMADEUS_ENV=test
