# Copy to .env and fill in real values.
DATABASE_URL=sqlite:///./voyager.db
# Neon also supported: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Plain postgresql:// URLs are normalized to the installed psycopg driver.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
# Also accepts SECRET_KEY, ALGORITHM and ACCESS_TOKEN_EXPIRE_MINUTES as aliases.
# Existing JWT_* names take precedence when both are present.

# CORS: comma-separated origins or a JSON array. Next.js uses port 3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Google Maps Distance Matrix API key. If unset, backend falls back
# to Haversine distance + a fixed speed heuristic per travel mode.
GOOGLE_MAPS_API_KEY=

# Amadeus Self-Service — powers /api/travel/hotels, /flights, /locations.
# If both values are blank the backend serves deterministic MOCK offers so
# the frontend still works — no signup required for demos.
#
# To use real live data (free tier, no card required):
#   1. Sign up at https://developers.amadeus.com/register
#   2. Verify your email, then create a Self-Service app in "My apps"
#   3. Copy the API Key + API Secret into the two lines below
#   4. Restart uvicorn
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (sandbox — matches signup) or "production" (after Amadeus approves).
AMADEUS_ENV=test

# Groq powers the dashboard chatbot and trip planner. Keep the account on Free.
# Model is listed in Groq's Free Plan limits; quota exhaustion never enables paid fallback.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenTripPlanner GraphQL — Executor Agent uses this for real transit
# polylines. Get a free Digitransit subscription key at
# https://portal-api.digitransit.fi/ (no card, ~30s). Leave blank and the
# ground_transfer tool falls back to a Haversine polyline.
OTP_GRAPHQL_URL=https://api.digitransit.fi/routing/v2/finland/gtfs/v1
OTP_CLIENT_NAME=voyager-hackathon
OTP_SUBSCRIPTION_KEY=
